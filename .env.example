# Copy to .env and adjust. Every variable is optional; defaults are documented in README "Configuration".
# Variables are added here as each stage introduces them. Invalid values stop the server at startup.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Optional comma-separated allowlist of source hosts. Empty = any public host.
# "*.example.com" matches subdomains. Private/internal addresses are blocked regardless.
ALLOWED_HOSTS=

# --- Resource limits (see README "Limits and safeguards" for the reasoning) ---
MAX_SOURCE_BYTES=15728640
FETCH_TIMEOUT_MS=10000
MAX_REDIRECTS=3
MAX_INPUT_PIXELS=40000000
PROCESSING_TIMEOUT_SECONDS=10
PROCESSING_CONCURRENCY=4
PROCESSING_QUEUE_SIZE=20
# 0 disables the in-memory result cache
CACHE_MAX_BYTES=134217728
CACHE_TTL_SECONDS=3600

# --- Abuse protection ---
# Requests per client IP per minute on /v1/process and /process. 0 disables.
RATE_LIMIT_PER_MINUTE=60
# Which proxies to trust for the client IP (X-Forwarded-For): false, a hop count
# (1 behind a single load balancer), or comma-separated IPs/CIDRs/loopback/linklocal/uniquelocal.
# "true" is refused: it would let any client spoof its IP.
TRUST_PROXY=false

# --- UI ---
# Built UI to serve at /. Unset: apps/web/dist if it has been built; otherwise API only.
# STATIC_DIR=/app/apps/web/dist
